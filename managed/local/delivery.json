{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bugdrop-managed-harness-delivery",
  "main": "../../src/managed/local/delivery.ts",
  "account_id": "STAGE_0_LOCAL_ONLY_NO_ACCOUNT",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "services": [
    {
      "binding": "LOCAL_AUTHORITY",
      "service": "bugdrop-managed-harness-authority"
    },
    {
      "binding": "LOCAL_FAKE_GITHUB",
      "service": "bugdrop-managed-harness-fake-github"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCAL_RECEIPTS",
        "class_name": "LocalManagedReceipt"
      }
    ]
  },
  "migrations": [
    {
      "tag": "local-harness-v1",
      "new_sqlite_classes": ["LocalManagedReceipt"]
    }
  ]
}
