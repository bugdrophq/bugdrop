{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "STAGING_ACCOUNT_NOT_APPROVED",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "name": "bugdrop-managed-github-disabled",
  "main": "../../src/managed/staging/github.ts",
  "env": {
    "staging": {
      "name": "bugdrop-managed-github-staging",
      "account_id": "STAGING_ACCOUNT_NOT_APPROVED",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "STAGING_ENABLED": "false",
        "STAGING_DELIVERY_ENABLED": "false",
        "STAGING_GITHUB_TARGET_JSON": "{}",
        "STAGING_APPLICATION_ID": "UNAPPROVED",
        "STAGING_DESTINATION_ID": "UNAPPROVED"
      },
      "secrets": {
        "required": [
          "STAGING_GITHUB_PRIVATE_KEY",
          "STAGING_GITHUB_WEBHOOK_SECRET",
          "STAGING_UNINSTALL_HMAC_KEY",
          "STAGING_UNINSTALL_COMMITMENT_KEY",
          "STAGING_RECONCILIATION_HMAC_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "STAGING_UNINSTALLS", "class_name": "StagingUninstall" }]
      },
      "migrations": [{ "tag": "staging-uninstall-v1", "new_sqlite_classes": ["StagingUninstall"] }],
      "services": [
        {
          "binding": "STAGING_RECONCILIATION",
          "service": "bugdrop-managed-reconciliation-staging",
          "entrypoint": "StagingReconciliation"
        },
        {
          "binding": "STAGING_AUTHORITY",
          "service": "bugdrop-managed-authority-staging",
          "entrypoint": "DeliveryAuthority"
        },
        {
          "binding": "STAGING_CONTROL",
          "service": "bugdrop-managed-authority-staging",
          "entrypoint": "StagingControl"
        }
      ]
    }
  }
}
