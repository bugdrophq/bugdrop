{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "STAGING_ACCOUNT_NOT_APPROVED",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "name": "bugdrop-managed-ingress-disabled",
  "main": "../../src/managed/staging/ingress.ts",
  "env": {
    "staging": {
      "name": "bugdrop-managed-ingress-staging",
      "account_id": "STAGING_ACCOUNT_NOT_APPROVED",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging",
        "STAGING_ENABLED": "false",
        "STAGING_OBSERVATION_ENABLED": "false",
        "STAGING_APPLICATION_ID": "UNAPPROVED",
        "STAGING_INSTALLATION_ID": "UNAPPROVED"
      },
      "services": [
        {
          "binding": "STAGING_AUTHORITY",
          "service": "bugdrop-managed-authority-staging",
          "entrypoint": "IssuerAuthority"
        },
        {
          "binding": "STAGING_DELIVERY",
          "service": "bugdrop-managed-delivery-staging",
          "entrypoint": "StagingDelivery"
        },
        {
          "binding": "STAGING_GITHUB_WEBHOOK",
          "service": "bugdrop-managed-github-staging",
          "entrypoint": "GithubWebhook"
        },
        {
          "binding": "STAGING_OBSERVATION",
          "service": "bugdrop-managed-authority-staging",
          "entrypoint": "StagingObservation"
        }
      ],
      "secrets": {
        "required": ["STAGING_OBSERVATION_HMAC_KEY"]
      }
    }
  }
}
