{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bugdrop-managed-local-delivery",
  "main": "../src/managed/delivery.ts",
  "account_id": "STAGE_0_LOCAL_ONLY_NO_ACCOUNT",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "MANAGED_STAGE": "local-scaffold"
  },
  "observability": {
    "enabled": false
  },
  "queues": {
    "producers": [
      {
        "binding": "MANAGED_OUTCOMES",
        "queue": "bugdrop-managed-local-outcomes"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MANAGED_RECEIPTS",
        "class_name": "ManagedReceipts"
      }
    ]
  },
  "migrations": [
    {
      "tag": "managed-local-v1",
      "new_sqlite_classes": ["ManagedReceipts"]
    }
  ]
}
